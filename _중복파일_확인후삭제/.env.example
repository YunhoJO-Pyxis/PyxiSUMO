# Supabase → Project Settings → Database → Connection string (URI)
# 배치는 직결(5432), 서버리스 함수에서 쓸 때는 풀러(6543)를 권장.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres?sslmode=require

# 한국어 표기/용어집 시트 (웹에 게시된 스프레드시트 ID). 없으면 동기화를 건너뛴다.
SHEET_ID=

# 웹페이지를 공개할 GitHub 저장소 (A_깃허브에올리기.bat 이 씁니다)
# GITHUB_REPO=https://github.com/<사용자>/<저장소>
